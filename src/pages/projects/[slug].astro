---
import Base from "../../layouts/Base.astro";
import { projects, type Project } from "../../data/profile";
import { loadReadme, renderReadme } from "../../lib/readme";

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props as { project: Project };
const { markdown, source } = await loadReadme(project.repo);
const html = renderReadme(markdown, project.repo);
const repoUrl = `https://github.com/efrino/${project.repo}`;

const index = projects.findIndex((p) => p.slug === project.slug);
const next = projects[(index + 1) % projects.length];
---

<Base title={`${project.title} · Case study · Efrino`} description={project.summary}>
  <article class="container case">
    <a class="back" href="/#projects">← All projects</a>

    <header class="case-head">
      <span class="emoji" aria-hidden="true">{project.emoji}</span>
      <h1>{project.title}</h1>
      <p class="lead">{project.summary}</p>
      <ul class="tags">
        {project.stack.map((s) => <li class="tag">{s}</li>)}
      </ul>
      <div class="actions">
        <a class="btn btn-primary" href={repoUrl} target="_blank" rel="noopener">View code on GitHub</a>
        {project.live && <a class="btn" href={project.live} target="_blank" rel="noopener">Live site ↗</a>}
      </div>
    </header>

    <div class="prose card" set:html={html} />

    <footer class="case-foot">
      <p class="source">
        {source === "github" ? "Rendered from " : "Rendered from a saved copy of "}
        <a href={`${repoUrl}#readme`} target="_blank" rel="noopener">the README on GitHub</a>.
      </p>
      <a class="btn" href={`/projects/${next.slug}/`}>Next: {next.title} →</a>
    </footer>
  </article>

</Base>

<script>
  // Bundled with the site (no CDN) and only downloaded on pages that have diagrams.
  const blocks = [...document.querySelectorAll<HTMLElement>("pre.mermaid")];
  if (blocks.length) {
    blocks.forEach((b) => (b.dataset.src = b.textContent ?? ""));
    const isDark = () =>
      document.documentElement.dataset.theme === "dark" ||
      (!document.documentElement.dataset.theme && matchMedia("(prefers-color-scheme: dark)").matches);
    const draw = async () => {
      const { default: mermaid } = await import("mermaid");
      blocks.forEach((b) => {
        b.removeAttribute("data-processed");
        b.textContent = b.dataset.src ?? "";
      });
      mermaid.initialize({ startOnLoad: false, theme: isDark() ? "dark" : "default", securityLevel: "strict" });
      await mermaid.run({ nodes: blocks });
    };
    draw();
    document.addEventListener("themechange", draw);
  }
</script>

<style>
  .case {
    padding-top: 32px;
    padding-bottom: 72px;
    max-width: 920px;
  }
  .back {
    display: inline-block;
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 24px;
  }
  .case-head {
    margin-bottom: 28px;
  }
  .case-head .emoji {
    font-size: 40px;
  }
  .case-head h1 {
    font-size: clamp(32px, 5vw, 46px);
    margin: 8px 0 12px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
  }
  .prose {
    padding: 8px 20px 28px;
  }
  @media (min-width: 720px) {
    .prose {
      padding: 8px 40px 40px;
    }
  }
  .case-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-top: 28px;
  }
  .source {
    color: var(--muted);
    font-size: 14px;
    margin: 0;
  }
</style>
